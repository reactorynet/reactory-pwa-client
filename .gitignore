# See https://help.github.com/ignore-files/ for more about ignoring files.

# dependencies
/node_modules

# testing
/coverage

# production
/build
/dist

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# yarn.lock IS tracked: without it CI resolved a different dependency tree on
# every run (no lockfile to hold the install to), which is why the typecheck gate
# drifted between machines and CI. npm is not used in this repo.
package-lock.json

/config/env*
!/config/env.ts
!/config/env/README.MD
!/config/env/reactory.local
!/config/env/**/Dockerfile*

# certificates
/certificates/*
!/certificates/readme.md

*.tgz

*storybook.log
storybook-static

/src/components/plugins/__index.ts

/src/**/*.jsx
/src/**/*.jsx.map
/src/**/*.js
/src/**/*.js.map

/.storybook/**/*.jsx
/.storybook/**/*.jsx.map

# Copilot CLI session transcripts (forms-engine modernization)
/.copilot-sessions/

# Jest transform cache
/.jest-cache/

coverage-app/*
# Yarn state only. Deliberately NOT a blanket `.yarn/*`: `yarn patch` writes
# `.yarn/patches` and a pinned `.yarn/releases` binary, and both must be tracked
# for a committed lockfile to be reproducible.
.yarn/cache
.yarn/install-state.gz
.yarn/build-state.yml
src/components/plugins/*
!src/components/plugins/pluginImportFactory.ts
!src/components/plugins/index.ts
!src/components/plugins/README.md
!src/components/plugins/example/
!src/components/plugins/example/*
# reactory-core plugin is a git submodule pointing at
# git@github.com:reactorynet/reactory-client-core-pwa-plugin.git
!src/components/plugins/reactory-core/
